# Clio Application Environment Configuration Template
# Copy this file to .env and populate with your credentials:
#   cp .env.example .env

# Server & Docker Port Configuration
PORT=4191
SERVER_PORT=3001
CLIO_DATA_DIR=./data

# Google Calendar OAuth 2.0 Credentials
# Create OAuth 2.0 Client ID in Google Cloud Console:
# 1. Enable Google Calendar API & Google People API
# 2. Add Authorized Redirect URI: https://chlio.ereuna.org
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://chlio.ereuna.org

# Firebase Admin SDK & Web Auth Credentials
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_APP_ID=your-firebase-web-app-id
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Jira Cloud Integration
# 1. Host: your workspace domain (e.g. yourcompany.atlassian.net)
# 2. API Token: Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_HOST=your-company.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=KAN

# Nextcloud WebDAV Integration
NEXTCLOUD_URL=http://localhost:8080
NEXTCLOUD_USERNAME=your-username
NEXTCLOUD_PASSWORD=your-app-password

# Ollama AI Local / Host Endpoint
OLLAMA_URL=http://localhost:11434

# Frontend Client Preferences (Vite import.meta.env)
VITE_USER_NAME=Your Name
VITE_USER_EMAIL=you@example.com
VITE_NEXTCLOUD_URL=
VITE_NEXTCLOUD_USERNAME=
